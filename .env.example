# ---- Server-side only. NEVER commit real values. ----

# Admin token that protects the AI settings page / key-management API (12+ chars). Required to manage keys.
ADMIN_TOKEN="CHANGE_ME_LONG_RANDOM_TOKEN"

# Encryption secret for keys saved from the admin UI (stored AES-256-GCM in data/ai-secrets.json).
# Without it, keys can only come from the environment variables below.
AI_SECRETS_ENCRYPTION_KEY="CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET"

# Optional: provide keys directly via environment instead of the UI.
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# DEEPSEEK_API_KEY=""
# GROQ_API_KEY=""

# Optional tuning
# AI_TIMEOUT_MS=20000
# PORT=3000
